{
  "name": "typebounds",
  "productName": "TypeBounds",
  "version": "0.1.0",
  "description": "TypeBounds - pixel typing tower defense",
  "private": true,
  "main": "electron.js",
  "scripts": {
    "prepare-app": "node build.js",
    "start": "node build.js && electron .",
    "dist": "node build.js && electron-builder --win portable"
  },
  "build": {
    "appId": "com.typebounds.game",
    "productName": "TypeBounds",
    "artifactName": "TypeBounds.exe",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron.js",
      "app/**"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
